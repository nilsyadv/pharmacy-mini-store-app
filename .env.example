# PostgreSQL Database Configuration
POSTGRES_DB=pharmacare
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# Application Configuration
PORT=5000
NODE_ENV=production

# Session Secret (Generate a random string for production - minimum 32 characters)
SESSION_SECRET=your_session_secret_here_min_32_characters

# Database URL (Auto-generated in docker-compose, but needed for local dev)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/pharmacare
